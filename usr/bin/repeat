#!/bin/bash

if [ "$#" -lt 2 ]; then
    echo "usage: repeat COUNT COMMAND [ARGUMENT...]" >&2
    exit 2
fi

case "$1" in
    ''|*[!0-9]*)
        echo "repeat: count must be a non-negative integer" >&2
        exit 2
        ;;
esac

count=$1
shift

for ((i = 0; i < count; i++)); do
    "$@" || exit $?
done
